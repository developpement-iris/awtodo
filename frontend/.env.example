# SSO Microsoft (Azure AD / Entra ID) — identifiants publics MSAL (SPA + PKCE),
# aucun n'est un secret. Ne jamais mettre de client secret ici (pas de flow
# confidentiel côté frontend).
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# API Watodo (Django). En dev, l'API est ouverte (AllowAny) — voir
# config/settings/dev.py côté backend.
VITE_API_BASE_URL=http://localhost:8000/api/v1
