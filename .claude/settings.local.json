{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Skill",
      "PowerShell"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/settings/production.py)",
      "Read(./**/settings/staging.py)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"C:\\\\Users\\\\a.zerrouki\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\hook.mjs\" ] || node \"C:\\\\Users\\\\a.zerrouki\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"C:\\\\Users\\\\a.zerrouki\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\hook.mjs\" ] || node \"C:\\\\Users\\\\a.zerrouki\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "description": "Toutes permissions accordées (Bash/Read/Write/Edit/Glob/Grep/WebFetch/WebSearch/Skill/PowerShell), sauf suppression forcée, force-push, et lecture des secrets/settings de prod. Impeccable design detector conservé : checks immédiats après Edit/Write/MultiEdit, passe complète au Stop."
}